# Required. Generate with: openssl rand -hex 32  (at least 32 bytes)
SESSION_SECRET=

# Production only (compose.prod.yaml). The dev stack hardcodes its own values.
DATABASE_PATH=/data/pachas.sqlite
ALLOW_REGISTRATION=false
COOKIE_SECURE=false
# Number of reverse proxies in front of the app whose X-Forwarded-For is trusted.
TRUST_PROXY=0
# Host interface and port to publish on. Use 0.0.0.0 to expose on the LAN.
PACHAS_BIND=127.0.0.1
PORT=3000

# Development only.
PACHAS_DEV_USE_POLLING=true
