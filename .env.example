# Copy this file to .env and fill in real values before running
# `docker compose up -d --build`. Do not commit the real .env file anywhere.

# Password for the Postgres user/database Pachas creates for itself.
POSTGRES_PASSWORD=change-this-strong-password

# Keys the session digests stored in the database. The app refuses to start
# without it. Generate one with: openssl rand -hex 32
#
# The browser's session cookie holds a random token; the database stores
# HMAC-SHA256(SESSION_SECRET, token). A database backup on its own is
# therefore useless for hijacking sessions.
#
# Changing this later logs out every user on every device.
SESSION_SECRET=change-this-to-a-long-random-string
