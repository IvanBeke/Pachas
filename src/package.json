{
  "name": "pachas",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted shared expense splitter.",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "start": "node .output/server/index.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate": "nuxt db generate",
    "make-admin": "node scripts/make-admin.mjs",
    "emoji:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-emoji-data.mjs",
    "test": "vitest run --project unit",
    "test:watch": "vitest",
    "test:api": "vitest run --project api",
    "typecheck": "nuxt typecheck"
  },
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.x",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@nuxtjs/i18n": "^10.6.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "h3": "^1.15.11"
  },
  "devDependencies": {
    "@nuxthub/core": "^0.10.8",
    "drizzle-kit": "^0.31.11",
    "emojibase-data": "^18.0.0",
    "nuxt": "^4.6.3",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.14"
  }
}
